# ==========================================
# Work Report Management System - Environment Variables
# ==========================================

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/work_report_db
DB_USERNAME=postgres
DB_PASSWORD=YourSecurePasswordHere

# JPA Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# Server Configuration
PORT=8080

# Frontend Configuration
VITE_API_BASE_URL=/api
